# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Sender Details
DEFAULT_SENDER_NAME=Your Full Name

# CV Configuration
# CV_PATH    : path ke berkas PDF CV Anda yang akan dilampirkan pada email lamaran
# CV_SUMMARY : path ke berkas teks/markdown berisi ringkasan isi CV Anda (dibaca AI untuk membuat draf email)
CV_PATH=cv.pdf
CV_SUMMARY_PATH=cv.md

# Bot Security Configuration
ALLOWED_TELEGRAM_USERNAME=your_telegram_username_here
